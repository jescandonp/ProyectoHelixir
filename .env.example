# Plantilla de variables. Copiar a `.env.local` para desarrollo local
# (`npx supabase start` imprime los valores) y cargar las de producción
# en Vercel. Este archivo sí se versiona: no lleva valores reales.

# --- Producción y desarrollo ---
# Las únicas dos que necesita la aplicación desplegada. Al llevar el
# prefijo NEXT_PUBLIC se incrustan en el bundle durante `next build`:
# tienen que existir en Vercel ANTES de construir, no solo en ejecución.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo local ---
# Salta RLS. La usan las pruebas de integración y el E2E para preparar y
# limpiar datos. NUNCA se carga en Vercel: filtrarla es entregar la base.
SUPABASE_SERVICE_ROLE_KEY=

# Usuario del Auth local contra el que corre la prueba end-to-end.
E2E_CORREO=
E2E_CLAVE=
